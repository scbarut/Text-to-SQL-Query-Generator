# ==========================================
# Backend Service Environment Variables
# ==========================================

# Google Gemini API Key (Required for LLM Text-to-SQL generation)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Configuration (defaults to gemini-2.5-flash-lite)
MODEL_NAME=gemini-2.5-flash-lite

# Database Connection URI (defaults to the SQLite demo database)
DATABASE_URL=sqlite:///./sql_app.db

