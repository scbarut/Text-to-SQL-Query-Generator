# ==========================================
# Text-to-SQL v2.0 - Environment Configuration
# ==========================================

# Google Gemini API Key (Required)
# Get a key at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Configuration (defaults to gemini-2.5-flash-lite)
MODEL_NAME=gemini-2.5-flash-lite

# Database Configuration (defaults to SQLite relational demo database)
# When running with Docker Compose: sqlite:///./api/sql_app.db
# When running backend locally: sqlite:///./sql_app.db
DATABASE_URL=sqlite:///./sql_app.db

# Frontend API Base URL
# Used by Vite during development and Docker builds
VITE_API_URL=http://localhost:8000
